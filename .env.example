# Copy this file to .env and fill in real values for your environment.
# No real secrets belong in this file or in version control.

# PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5432/ems
DB_USERNAME=ems
DB_PASSWORD=change-me

# Also used by docker-compose.yml's db service
POSTGRES_DB=ems

# JWT signing secret - use a long, random, base64-safe string in real environments.
JWT_SECRET=change-this-to-a-long-random-secret-value

# Active Spring profile: "dev" for local development, "default"/"prod" otherwise.
SPRING_PROFILES_ACTIVE=dev
