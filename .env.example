# Copy to .env for local Compose use. Do not commit .env or use these placeholders in production.
APP_ENV=development
DATABASE_URL=mysql://gym_user:replace-with-a-local-password@mysql:3306/gym_api?charset=utf8mb4
MYSQL_DATABASE=gym_api
MYSQL_USER=gym_user
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password
JWT_SECRET=replace-with-a-long-random-secret-generated-for-this-environment
JWT_ISSUER=gym-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
