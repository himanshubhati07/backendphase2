# Copy this file to .env for Docker Compose. These are deliberately nonproduction
# credentials and secrets; replace all of them for any deployed environment.
# The URLs below use the Compose service hostname. A test process running on a
# host may supply its own TEST_DATABASE_URL separately (for example with its
# host PostgreSQL endpoint); it must still name task_manager_test, not task_manager.

# PostgreSQL entrypoint initialization values
POSTGRES_DB=task_manager
POSTGRES_USER=task_user
POSTGRES_PASSWORD=task_password

# Application and dedicated test database connections used inside Compose
DATABASE_URL=postgresql://task_user:task_password@db:5432/task_manager
TEST_DATABASE_URL=postgresql://task_user:task_password@db:5432/task_manager_test

# Application runtime settings
JWT_SECRET=development-only-change-before-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEFAULT_TASK_LIMIT=20
MAX_TASK_LIMIT=100
