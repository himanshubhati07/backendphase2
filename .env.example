# Django runtime configuration
DJANGO_SECRET_KEY=<generate-a-long-random-secret>
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_USE_SQLITE=false
LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=30

# MySQL configuration
MYSQL_DATABASE=story_api
MYSQL_USER=story_user
MYSQL_PASSWORD=<set-a-strong-password>
MYSQL_ROOT_PASSWORD=<set-a-strong-root-password>
MYSQL_HOST=db
MYSQL_PORT=3306
