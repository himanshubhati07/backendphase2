# Required secrets for docker compose. Replace these example values before starting.
MYSQL_PASSWORD=change-this-app-password
MYSQL_ROOT_PASSWORD=change-this-root-password
JWT_SECRET=replace-with-a-long-random-jwt-signing-secret-at-least-32-characters

# Application startup settings (these match application.yml defaults and compose values).
SERVER_PORT=8000
DB_URL=jdbc:mysql://mysql:3306/student_management?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=student_app
# Used when starting the application outside compose. Compose supplies MYSQL_PASSWORD as DB_PASSWORD.
DB_PASSWORD=change-this-app-password
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=student-management-audit
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRATION_MINUTES=10080
